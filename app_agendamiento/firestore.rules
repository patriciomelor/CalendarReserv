rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSuperAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'super_admin';
    }

    function isSalonAdmin(salonId) {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return user.rol == 'admin' && user.salonId == salonId;
    }

    // NUEVA FUNCIÓN: Verifica si el solicitante es el profesional asignado a una cita.
    function isTheAssignedProfessional(appointment) {
      // Obtiene el ID del profesional desde la cita.
      let professionalId = appointment.professionalId;
      // Obtiene el documento del profesional usando ese ID.
      let professionalDoc = get(/databases/$(database)/documents/professionals/$(professionalId)).data;
      // Compara el UID guardado en el documento del profesional con el UID del solicitante.
      return professionalDoc.uid == request.auth.uid;
    }

    // --- Collection Rules ---

    match /salones/{salonId} {
      allow get: if request.auth != null; // Permite a usuarios autenticados (incl. anónimos) leer un salón.
      allow list: if request.auth != null; // Permite a CUALQUIER usuario autenticado (incl. anónimos) listar salones.
      allow create: if isSuperAdmin();
      allow update, delete: if isSalonAdmin(salonId) || isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      // Permite a un usuario crear su propio documento, o a un admin crear usuarios.
      allow create: if request.auth.uid == userId || isSuperAdmin() || isSalonAdmin(request.resource.data.salonId);
      allow update: if request.auth.uid == userId;
      allow delete: if isSuperAdmin();
    }

    match /professionals/{professionalId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isSalonAdmin(request.resource.data.salonId);
    }

    match /services/{serviceId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isSalonAdmin(request.resource.data.salonId);
    }

    match /appointments/{appointmentId} {
      // REGLA CORREGIDA: El cliente, el admin del salón, o el profesional asignado (verificado con la nueva función).
      allow read: if request.auth != null;

      allow create: if request.auth != null;
      allow update: if request.auth.uid == resource.data.customerId || isSalonAdmin(resource.data.salonId);
      allow delete: if isSalonAdmin(resource.data.salonId);
    }
  }
}
